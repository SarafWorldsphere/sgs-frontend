# Full URL of the parent backend's SSO endpoint. Leave unset until the parent
# dashboard verifies tokens — Parent logins then redirect without one, as before.
SGS_PARENT_SSO_URL=
# Full URL of the admin backend's SSO endpoint. Same rule: leave unset until the
# admin dashboard verifies tokens. On a multi-school deployment point this at the
# local port, not a public hostname — the request carries the browser's Host
# header, which is what tells the backend which school is asking.
SGS_ADMIN_SSO_URL=
